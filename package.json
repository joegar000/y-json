{
  "name": "y-json",
  "version": "1.0.0",
  "description": "Library for interfacing with yjs through simple json object-esque operations.",
  "license": "ISC",
  "author": "joegar000",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "check": "npm run typecheck && npm test -- --runInBand && npm run lint:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "es-toolkit": "^1.53.2"
  },
  "peerDependencies": {
    "mobx": "^7.1.5",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "mobx": "^7.1.5",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "yjs": "^13.6.33"
  }
}
