{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022",
      "ESNext.Collection",
      "ESNext.Disposable"
    ],
    "noEmit": false,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "sourceMap": true,
    "target": "ES2022",
    "types": []
  },
  "include": ["src/*.ts"],
  "exclude": ["src/__tests__"]
}
